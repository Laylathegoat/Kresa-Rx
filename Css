header{
    display: flex;
    position: sticky;
    top: 0;
    align-content: center;
    align-items: center;
    justify-content: space-between;
    background-color:rgb(129, 16, 16);
    width: 100%;
    min-width: 1300px;
    height: 120px;
    border-bottom:5px solid gray;
}
header img {
    margin-left: 10px;
    height: 100px
}
header button {
    font-size: 20px;
    text-align: center;
}

#searchbar{
    border-radius: 100px;
    border: solid 4px gray;
    padding: 3px;
    background-color:black;
    color: white;
   margin: 0%;
   font-size: large;
   font-family: Arial, Helvetica, sans-serif;
   
}
#searchbar::placeholder {
    color: white;
}

#searchbutton {
    border: none;
    background: none;
    color: black;
}

#searchbutton:hover {
    opacity: 0.75;
}
header input {
    width: 900px;
    height: 50px;
}
#epicbuttons {
    font-size: 70px;
    background:none;
    border:none;
    color:grey;
    margin: 0 5px;

}
.epicbuttons:hover {
    opacity: 1;
}
.frontpage1 {
    width:100%;
    height: 500px;
    background-image:url("https://www.emoryhealthcare.org/-/media/Project/EH/Emory/ui/images/services/pharmacy/pharm-page-102561372.jpg?h=533&iar=0&w=800&hash=5F48DBF3DEA93566CE69D52EE76A4B72");
   background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  background-size: cover;
}

.frontpage1 h1 {
    margin: 10px;
    margin-left: 100px;
    font-size:  60px;
    
}
.frontpage1 a {
    width: 50%;
    text-align: center;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    color: black;
    text-decoration:underline;
    
}
.frontpage1 a:hover {
    opacity: 0.6;
}
